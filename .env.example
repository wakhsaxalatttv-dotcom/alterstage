PORT=3001
# Secret de modération serveur : générer avec openssl rand -hex 32. Ne pas versionner.
ADMIN_TOKEN=
# Disque persistant requis en production ; cette valeur est un chemin, pas un secret.
DATA_DIR=.local
# Chemin vers un fichier JSON local de sources autorisées (jamais une URL utilisateur).
SOURCES_FILE=
# 0 : collecte manuelle ; minimum 5 minutes pour activer le planificateur.
INGEST_INTERVAL_MINUTES=0
# La Bonne Alternance : clé privée, gratuite, pour un usage non lucratif uniquement.
LBA_API_KEY=
# false pour désactiver la collecte LBA ; aucun secret n'est fourni dans ce modèle.
LBA_ENABLED=true
# France Travail : identifiants privés de l’application abonnée à l’API Offres d’emploi.
# Dans Render, utiliser exactement ces deux noms ; ne jamais préfixer par VITE_.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Collecte automatique au démarrage lorsque les deux identifiants sont présents.
FRANCE_TRAVAIL_ENABLED=true
# Pages par fenêtre (1–10) avant découpage automatique par période.
FRANCE_TRAVAIL_MAX_PAGES=10
# Budget de requêtes par collecte ; un dépassement est signalé comme partiel.
FRANCE_TRAVAIL_MAX_REQUESTS=2000

# Test RapidAPI privé uniquement, sans collecte ni publication automatique.
RAPIDAPI_LINKEDIN_KEY=

# SerpApi Google Jobs : collecte, analyse et publication automatiques des offres admissibles.
# Ne jamais préfixer par VITE_ ni copier cette clé dans le navigateur.
SERPAPI_API_KEY=

# false pour désactiver la rotation ; aucun bouton d’import nécessaire.
SERPAPI_AUTO_ENABLED=true
# Budget automatique persistant, au plus 3 appels/heure ; adapter au quota réel du compte.
SERPAPI_DAILY_REQUEST_LIMIT=24
# Fréquence de renouvellement d’une recherche, en jours (1 à 30).
SERPAPI_REFRESH_DAYS=7

# Comptes candidats Supabase (désactivés tant que la migration n’est pas appliquée).
# URL et clé publique du projet : valeurs publiques déjà dans config/candidate-service.json.
CANDIDATE_ACCOUNTS_ENABLED=false
SUPABASE_URL=https://qyffhxibnvnbvtggjhwl.supabase.co
SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SITE_URL=https://alterstage.onrender.com
# Clé serveur PRIVÉE : statistiques agrégées et alertes en arrière-plan seulement.
# À renseigner dans Render uniquement ; jamais VITE_ ni dans le dépôt ou le chat.
SUPABASE_SERVICE_ROLE_KEY=
# Alertes de nouveautés par e-mail, facultatives. Supabase Auth a sa propre configuration SMTP.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Offres Fraîches
