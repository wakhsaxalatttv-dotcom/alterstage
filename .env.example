PORT=3001
# Secret de modération serveur : générer avec openssl rand -hex 32. Ne pas versionner.
ADMIN_TOKEN=
# Disque persistant requis en production ; cette valeur est un chemin, pas un secret.
DATA_DIR=.local
# Chemin vers un fichier JSON local de sources autorisées (jamais une URL utilisateur).
SOURCES_FILE=
# 0 : collecte manuelle ; minimum 5 minutes pour activer le planificateur.
INGEST_INTERVAL_MINUTES=0
# La Bonne Alternance : clé privée, gratuite, pour un usage non lucratif uniquement.
LBA_API_KEY=
# false pour désactiver la collecte LBA ; aucun secret n'est fourni dans ce modèle.
LBA_ENABLED=true
